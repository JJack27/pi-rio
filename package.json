{
  "name": "pi-rio",
  "version": "0.1.0",
  "description": "A cheap-model Radar Intercept Officer (RIO) for Pi that turns raw agent thinking and tool calls into a live reasoning trail.",
  "type": "module",
  "license": "MIT",
  "author": "Yizhou Zhao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJack27/pi-rio.git"
  },
  "homepage": "https://github.com/JJack27/pi-rio#readme",
  "bugs": {
    "url": "https://github.com/JJack27/pi-rio/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "sidecar",
    "observability",
    "reasoning",
    "tui"
  ],
  "files": [
    "src",
    "assets",
    "logo.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/JJack27/pi-rio/main/assets/preview.svg"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
